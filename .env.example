# Copy to .env and adjust. All variables are optional; defaults are safe and
# fully offline (no API key needed). Settings use the EP_ prefix.

EP_ENVIRONMENT=local

# Time-of-use tariff. Hours in [EP_PEAK_START_HOUR, EP_PEAK_END_HOUR) are billed
# at the peak rate; every other hour is off-peak. Rates are integer cents per kWh.
EP_PEAK_START_HOUR=17
EP_PEAK_END_HOUR=21
EP_PEAK_RATE_CENTS=30
EP_OFFPEAK_RATE_CENTS=12

# Overnight window [start, end) used to read off the always-on base load.
EP_OVERNIGHT_START_HOUR=0
EP_OVERNIGHT_END_HOUR=6

# Savings assumptions, as whole percentages (keeps the money math exact).
EP_SHIFTABLE_PCT=30
EP_STANDBY_REDUCTION_PCT=25

# How many hours-of-day to report as the usage peak.
EP_TOP_USAGE_HOURS=3

# LLM provider cascade, tried in order. With no provider key set below, the
# advisor uses the deterministic template and makes no network calls.
EP_LLM_SPEC=anthropic,openai,gemini,deepseek,ollama
EP_LLM_MAX_TOKENS=500

# Provider API keys (set the ones you use):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
